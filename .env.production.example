# Reference for your hosting environment/secrets store; not loaded as a file.
# Set NODE_ENV externally before starting the app or running migrations.
NODE_ENV=production
PORT=3000

# Managed PostgreSQL URL, including provider-required TLS options.
DATABASE_URL=

# Required: distinct random secrets, each at least 32 bytes.
# Generate each separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
