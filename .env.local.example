# Local application. Shell variables override this file.
NODE_ENV=development
PORT=3000

# PostgreSQL container (local-only credentials).
POSTGRES_USER=topicflow
POSTGRES_PASSWORD=topicflow_local_dev
POSTGRES_DB=topicflow

# Backend runs on the host; keep credentials aligned with POSTGRES_* above.
DATABASE_URL=postgresql://topicflow:topicflow_local_dev@localhost:5432/topicflow?schema=public

# Local-only signing keys. Use independently generated keys in production.
JWT_ACCESS_SECRET=local-only-access-secret-change-before-deploy-123
JWT_REFRESH_SECRET=local-only-refresh-secret-change-before-deploy-456
