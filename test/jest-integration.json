{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "testRegex": "\\.integration-spec\\.ts$",
  "testTimeout": 120000,
  "testLocationInResults": true,
  "reporters": [
    "default",
    ["<rootDir>/tools/testing/ci-reporter.cjs", { "group": "integration" }]
  ],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
